# Credenciales y entorno
.env
.kaggle/

# Entorno virtual
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo

# Datos pesados y caché (se regeneran)
data/raw/
data/processed/
# 'models/*' (no 'models/') para poder re-incluir un subdirectorio: Git no
# desciende en un directorio ignorado por completo, así la negación de abajo
# solo funciona si excluimos el CONTENIDO, no la carpeta entera.
models/*
*.parquet

# --- Excepciones: SÍ se versionan ---
# Modelos base estáticos (artefactos reproducibles: model_v0, model_v0_balanced…)
!models/model_v0/
!models/model_v0/**
!models/model_v0_balanced/
!models/model_v0_balanced/**
# Run logs y reportes del trading en vivo: dataset de reentrenamiento que los
# workflows de GitHub Actions commitean en cada corrida. Se re-incluyen pese a
# las reglas data/ y *.parquet de arriba (su carpeta padre no está ignorada).
!data/live/
!data/live/**
# Temporales intermedios del live_runner (no son datos de reentrenamiento)
data/live/_*

# --- Datos externos pesados: NUNCA en el repo ---
# Viven en D:\trading-data (disco aparte). Reglas DEFENSIVAS por si alguien crea
# un junction/mklink dentro del repo o copia datasets por error. Si algo de esto
# aparece dentro del árbol del repo, Git lo ignora.
trading-data/
**/trading-data/
data/external/
data/raw/external/
**/external_data/
# Datasets externos en CSV/TSV pesados (los del repo viven en data/raw|processed,
# ya ignorados; estas reglas atrapan CSV sueltos fuera de esas carpetas).
data/**/*.csv
!data/sp500_tickers.csv
*.tsv
*.csv.gz
*.parquet.gz

# Sistema
.DS_Store
*.log

# Logs del live_runner (Task Scheduler) — nunca se commitean
logs/
